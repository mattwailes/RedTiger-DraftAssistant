{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CLI: install deps",
      "type": "shell",
      "command": "pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}/cli" }
    },
    {
      "label": "Web: install deps",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/web" }
    },
    {
      "label": "Web: dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/web" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
